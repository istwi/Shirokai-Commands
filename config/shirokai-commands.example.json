{
  "configVersion": 1,
  "settings": {
    "opBypass": true,
    "defaultMode": "allow",
    "whitelistEnabled": false,
    "autoRefreshTab": true,
    "luckPermsIntegration": true,
    "logBlockedCommands": true,
    "silentBlockedCommands": false,
    "guardInternalPlayerCommands": false
  },
  "messages": {
    "blocked": "§cVocê não tem permissão para usar este comando.",
    "unknown": "§cComando desconhecido.",
    "reload": "§aConfigurações recarregadas com sucesso.",
    "aliasConflict": "§cEste alias já está sendo utilizado."
  },
  "commands": {
    "calculate": {
      "mode": "hide"
    },
    "center": {
      "mode": "block"
    },
    "balance": {
      "mode": "replace",
      "alias": "money"
    },
    "warp spawn": {
      "mode": "replace",
      "alias": "spawn"
    },
    "kit admin": {
      "mode": "block"
    }
  },
  "tabFilters": [
    {
      "command": "pay",
      "argumentIndex": 2,
      "onlinePlayersOnly": true
    },
    {
      "command": "pay",
      "argumentIndex": 3,
      "hidePrefixes": [
        "impactor:"
      ]
    },
    {
      "command": "pay",
      "argumentIndex": 4,
      "hideAll": true
    }
  ],
  "argumentAliases": {
    "pay_cash": {
      "alias": "pay cash {quantidade} {jogador}",
      "target": "pay {quantidade} {jogador} cash",
      "extendExisting": true,
      "argumentLabel": "quantidade_jogador"
    },
    "pay_dollars": {
      "alias": "pay dollars {quantidade} {jogador}",
      "target": "pay {quantidade} {jogador} dollars",
      "extendExisting": true,
      "argumentLabel": "quantidade_jogador"
    },
    "pay_tokens": {
      "alias": "pay tokens {quantidade} {jogador}",
      "target": "pay {quantidade} {jogador} tokens",
      "extendExisting": true,
      "argumentLabel": "quantidade_jogador"
    },
    "home_tp": {
      "alias": "home {nome}",
      "target": "home tp {nome}",
      "extendExisting": true,
      "argumentLabel": "nome"
    }
  }
}
